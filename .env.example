# Copy this file to ".env" and fill in your own values. Never share or commit .env.

# Your Invo refresh token (from the browser console script). One long line starting with eyJ, no quotes.
INVO_REFRESH_TOKEN=eyJ...your-refresh-token-here

# Your Invo wallet address (starts with 0x).
WALLET_ADDRESS=0x...your-invo-wallet-address-here

# Only for "hyperliquid" mode (your own Hyperliquid account). Not needed in the default "invo" mode.
# HL_AGENT_KEY=0x...your-agent-private-key-here
